# All scheduling is evaluated in this IANA time zone.
TIMEZONE=Europe/Istanbul

# The inclusive daily delivery window, in 24-hour HH:MM format.
SEND_WINDOW_START=06:30
SEND_WINDOW_END=22:30

# Number of evenly distributed notifications within the daily window.
DAILY_NOTIFICATION_COUNT=4

# Docker Compose overrides this to /data, which is backed by the bot-data volume.
# For local execution, leave this as the project-local directory below.
DATA_DIR=data
