# All scheduling is evaluated in this IANA time zone.
TIMEZONE=Europe/Istanbul

# Language used by the console-only delivery flow: ara, eng, tur or deu.
CONSOLE_LANGUAGE=ara

# The inclusive daily delivery window, in 24-hour HH:MM format.
SEND_WINDOW_START=06:30
SEND_WINDOW_END=22:30

# Number of evenly distributed notifications within the daily window.
DAILY_NOTIFICATION_COUNT=4

# Maximum wait time for each source API request, in seconds.
HTTP_TIMEOUT_SECONDS=30

# This is project-relative both locally and in Docker.
# Docker Compose persists it in the bot-data volume.
DATA_DIR=data

# Telegram bot token
TELEGRAM_BOT_TOKEN=